<style>
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
          padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
        }
        @media screen and (min-width: 991px){
        .logos-sec .logo-box-row .swiper-wrapper{display: flex; gap: 50px; justify-content: center;}
        .logos-sec .logo-box-row .logo-box{flex: 1 1 25%;}
        }
        .logos-sec .logo-link{display: flex; justify-content: center;}
        .logos-sec .heading-title{padding-bottom: 64px; text-align: center;}
        
      @media screen and (min-width: 440px) {
          .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
          }
    }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="logos-sec section-{{ section.id }}-padding page-width">
    <div class="heading-title">
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="logo-box-row swiper">
      <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'logos-box' %}
          <div class="logo-box swiper-slide">
            <a class="logo-link" href="{{ block.settings.logo_link }}">
              <img src="{{ block.settings.logo | img_url: '180x180' }}" height="180" width="180" alt="logo">
            </a>
          </div>
        {% endif %}
      {% endfor %}
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    let kiteSwiper = null;

    function initKiteSwiper() {
      if (window.innerWidth <= 991 && !kiteSwiper) {
        kiteSwiper = new Swiper('.logo-box-row', {
          loop: true,
          speed: 5000,
          autoplay: {
            delay: 0,
            disableOnInteraction: false,
          },
          allowTouchMove: false,
          breakpoints: {
            0: {
              slidesPerView: 2,
              spaceBetween: 12,
            },
            601: { 
              slidesPerView: 3,
              spaceBetween: 24,
            }
          }
        });

        // force linear flow
        document.querySelector('.logo-box-row .swiper-wrapper')
          .style.transitionTimingFunction = 'linear';
      } else if (window.innerWidth > 991 && kiteSwiper) {
        kiteSwiper.destroy(true, true);
        kiteSwiper = null;
      }
    }

    initKiteSwiper();
    window.addEventListener('resize', initKiteSwiper);
  });
</script>

{% schema %}
{
  "name": "logos",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logos-box",
      "name": "Logos Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "logo"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Logo Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos",
      "blocks": [{ "type": "logos-box" }]
    }
  ]
}
{% endschema %}
