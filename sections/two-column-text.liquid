<style>
  @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
 .two-col-wrapper{display: flex; gap: 7px 30px; justify-content: space-between;}
 .two-column-text-section .hb-heading{max-width: {{section.settings.heading-numbers}}px; letter-spacing: -1px;}
 .two-column-text-section .btn{margin-top: 18px; width: 216px;}
  .two-column-text-section .description{max-width: {{section.settings.para-numbers}}px; color: rgba({{ section.settings.description_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, 0.6); padding-top: 6px;}
@media screen and (max-width: 767px){
.two-col-wrapper{flex-wrap: wrap;}
.section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top-mobile}}px;
      padding-bottom: {{ section.settings.padding_bottom-mobile}}px;
    }
 .two-column-text-section .description{max-width: 100%;}
}
@media screen and (max-width: 400px){
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top-mobile | times: 0.50 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom-mobile | times: 0.50 | round: 0 }}px;
    }
 .two-column-text-section .description{max-width: 100%;}
}
</style>
{% if section.settings.description != blank or section.settings.heading != blank %}
<div class="two-column-text-section color-{{ section.settings.color_scheme }}">
  <div class="section-{{ section.id }}-padding page-width">
    <div class="two-col-wrapper">
      <div class="left-col">
        <div class="content-box">
          {% if section.settings.heading != blank %}
            <h2 class="hb-heading">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>
      </div>
      <div class="right-col">
        <div class="content-box">
          {% if section.settings.description != blank %}
            <div class="description">
              {{ section.settings.description }}
            </div>
          {% endif -%}
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            <a class="btn button solid-button" href="{{ section.settings.button_link }}" class="btn">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Two Column Text",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
        "type": "color",
        "id": "description_color",
        "label": "Description Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "number",
      "id": "heading-numbers",
      "label": "Heading Maxwidth"
    },
    {
      "type": "number",
      "id": "para-numbers",
      "label": "Description Maxwidth"
    },
    {
      "type": "range",
      "id": "padding_top-mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding-top-mobile",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom-mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding-bottom-mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Two Column Text",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
