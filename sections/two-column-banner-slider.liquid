{% stylesheet %}
.two-column-banner-slider {overflow-x: hidden;}
.two-column-banner-slider .banner-swipper img{height: 100%; width: 100%; object-fit: cover;}
.two-column-banner-slider .swiper-wrapper{flex-wrap: nowrap;}
.two-column-banner-slider .swiper-slide{flex: 0 0 100%;}
.two-column-banner-slider .content{ width: 550px; margin-left: auto; }
.two-column-banner-slider .btn{font-size: 24px; padding: 16px 48px;}
.two-column-banner-slider .main-heading{margin: 8px 0 12px; max-width: 463px;}
.two-column-banner-slider .left-column{display: flex; flex-direction: column; justify-content: center;}
.two-column-banner-slider .description{font-size: 20px; line-height: 1.4; margin-bottom: 20px; max-width: 360px; color: rgba(var(--color-foreground)); font-family: "Open Sans", sans-serif;}
.two-column-banner-slider .button-box {margin-top: 32px;}
.two-column-banner-slider .two-column-wrapper { display: flex; align-items:  stretch;} 
.two-column-banner-slider .right-column { position: relative; overflow: hidden;}
.two-column-banner-slider .banner-swipper {overflow: hidden; height: 100%; max-height: 660px;}
@media screen and (max-width: 1199px){
.two-column-banner-slider .content{ max-width: 560px; padding: 50px 0 50px 50px;margin: 0;}
}
@media screen and (max-width: 991px){
.two-column-banner-slider .content{ max-width: 450px; padding: 20px 0 16px 20px;margin: 0;}
.avatars-stats .avatars-img-box img{width: 51px; height: 51px; margin-right: -15px;}
}
@media screen and (max-width: 767px){
  .two-column-banner-slider .two-column-wrapper{flex-wrap: wrap;}
  .two-column-banner-slider .content{padding: 56px 16px 64px; max-width: 100%; width: 100%;}
    
}
@media screen and (max-width: 439px){
  .two-column-banner-slider .main-heading{font-size: 46px; line-height: 1.2; max-width: 320px;}
  .two-column-banner-slider .description{max-width: 320px; font-size: 18px;}

}
{% endstylesheet %}

<section class="two-column-banner-slider color-{{ section.settings.color_scheme }}">
  <div class="container-full">
    <div class="two-column-wrapper">
      <div class="col-6 left-column">
        <div class="content">
          <div class="reviews">
            <span class="stars">
              <img class="stars-img" src="{{ section.settings.stars | img_url }}" width="97" height="20" alt="Customer">
            </span>
            <span class="review-text">{{ section.settings.review_text }}</span>
          </div>
          <div class="text-box">
            <h1 class="main-heading">{{ section.settings.heading }}</h1>
            <p class="description">{{ section.settings.description }}</p>
          </div>
          <div class="avatars-stats">
            <div class="avatars">
              {% for block in section.blocks %}
                {% if block.type == 'avatar' %}
                  <div class="avatars-img-box">
                    <img src="{{ block.settings.avatar | img_url: '50x50' }}" height="100" width="100" alt="Customer">
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="stats">
              {{ section.settings.stats_text }}
            </div>
          </div>
          <div class="button-box">
            <a href="{{ section.settings.button_link }}" class="btn button solid-button color-black">
              {{ section.settings.button_text }}
            </a>
          </div>
        </div>
      </div>
      <div class="col-6 right-column">
        <div class="swiper banner-swipper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% if block.type == 'slide' %}
                <div class="swiper-slide">
                  <img src="{{ block.settings.slide_image | img_url: '800x' }}" alt="Slide">
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <div class="swiper-button-prev arrows">{{- 'icon-leftarrow.svg' | inline_asset_content -}}</div>
          <div class="swiper-button-next arrows">{{- 'icon-rightarrow.svg' | inline_asset_content -}}</div>
        </div>
      </div>
    </div>
  </div>
</section>
{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.banner-swipper', {
        loop: true,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
      });
    }
  });
{% endjavascript %}
{% schema %}
{
  "name": "Two Column Banner Swiper",
  "settings": [
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "5000+ Reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "image_picker",
      "id": "stars",
      "label": "Stars Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "richtext",
      "id": "stats_text",
      "label": "Stats Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Customer Avatar",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar Image"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Slider Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Slide Image"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Two Column Banner Swiper",
      "category": "Banner"
    }
  ]
}
{% endschema %}
