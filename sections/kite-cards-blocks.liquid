<style>
  @media screen and (min-width: 767px){
     .kite-cards-section .pre-next-buttons{display: none;}
  }
  .kite-cards-section .kite-card{flex: 1 1 calc(50% - 8px); position: relative;}
  .kite-cards-section .kite-card h3{letter-spacing: 0;}
  .kite-cards-section .swiper-wrapper img.card-image{height: 212px;width: 100%; object-fit: cover;border-radius: 16px;}
  .kite-card-image-wrapper{ border-radius: 16px;}
  .kite-cards-section .kite-card-overlay{position: absolute; top: 0; right: 0; bottom: 0; left: 0; padding: 18px 22px; display: flex; align-items: flex-end;}
  .kite-cards-section .kite-card-content{max-width: 202px;}
  .kite-cards-section .swiper-wrapper{flex-wrap: wrap; gap: 16px;}
  .kite-cards-section .review-container{position: absolute; top: 50%; transform: translateY(-50%); right: 22px; padding: 6.5px; border-radius: 52.463px;}
  .kite-cards-section .avatars-stats{gap: 18px; font-size: 10.493px; line-height: 1.5; padding-right: 20px;}
  .kite-cards-section .reviews{padding: 3.5px 13.5px;}
  .kite-cards-section .avatars-stats .avatars-img-box img{width: 41px; height: 41px; margin-right: -12px;}
  @media screen and (max-width: 767px){
    .kite-cards-section .kite-card{flex: 0 0 100%; margin-right: 0 !important;}
    .kite-cards-section .swiper-wrapper img.card-image{height: 202px; object-fit: cover; width: 100%;}
    .kite-cards-section .swiper-wrapper{flex-wrap: nowrap;}
  }
</style>

<section class="kite-cards-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="kite-cards-wrapper swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'kite_card' %}
            <div class="kite-card swiper-slide">
              <a href="{{ block.settings.card_link }}">
                <div class="kite-card-image-wrapper">
                  {% if block.settings.card_image != blank %}
                    <img class="card-image"
                      src="{{ block.settings.card_image | img_url: 'master' }}"
                      alt="{{ block.settings.heading | escape }}"
                    >
                  {% endif %}
                  <div
                    class="kite-card-overlay"
                    style="background-color: rgba({{ block.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ block.settings.overlay_opacity }});"
                  >
                    <div class="kite-card-content">
                      {% if block.settings.heading != blank %}
                        <h3>{{ block.settings.heading }}</h3>
                      {% endif %}
                    </div>

                    {% if block.settings.show_reviews %}
                      <div class="review-container color-{{ section.settings.review-color-scheme }}">
                        <div class="reviews">
                          <span class="stars">
                            <img
                              class="stars-img"
                              src="{{ section.settings.stars | img_url }}"
                              width="97"
                              height="20"
                              alt="Customer"
                            >
                          </span>
                          <span class="review-text">{{ section.settings.review_text }}</span>
                        </div>
                      </div>
                    {% endif %}

                    {% if block.settings.show_reviews_box %}
                      <div class="review-container color-{{ section.settings.review-color-scheme }}">
                        <div class="avatars-stats">
                          <div class="avatars">
                            {% for avatar_block in section.blocks %}
                              {% if avatar_block.type == 'avatar' %}
                                <div class="avatars-img-box">
                                  <img src="{{ avatar_block.settings.avatar | img_url: '50x50' }}" alt="Customer">
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                          <div class="stats">
                            {{ section.settings.stats_text }}
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="pre-next-buttons">
        <div class="kite-swiper-button-prev arrows">{{- 'icon-leftarrow.svg' | inline_asset_content -}}</div>
        <div class="kite-swiper-button-next arrows">{{- 'icon-rightarrow.svg' | inline_asset_content -}}</div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let kiteSwiper = null;

    function initKiteSwiper() {
      if (window.innerWidth <= 767 && !kiteSwiper) {
        kiteSwiper = new Swiper('.kite-cards-wrapper', {
          slidesPerView: 1,
          spaceBetween: 20,
          pagination: {
            clickable: true,
          },
          navigation: {
            nextEl: '.kite-swiper-button-next',
            prevEl: '.kite-swiper-button-prev',
          },
        });
      } else if (window.innerWidth > 767 && kiteSwiper) {
        kiteSwiper.destroy(true, true);
        kiteSwiper = null;
      }
    }

    initKiteSwiper();
    window.addEventListener('resize', initKiteSwiper);
  });
</script>

{% schema %}
{
  "name": "Kite Cards blocks",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme"
    },
    {
      "type": "image_picker",
      "id": "stars",
      "label": "Review Stars Image"
    },
    {
      "type": "color_scheme",
      "id": "review-color-scheme",
      "label": "Review sColor Scheme"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text"
    },
    {
      "type": "richtext",
      "id": "stats_text",
      "label": "Stats Text"
    }
  ],
  "blocks": [
    {
      "type": "kite_card",
      "name": "Kite Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card Title"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.4
        },
        {
          "type": "checkbox",
          "id": "show_reviews",
          "label": "Show Stars & Review Text",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_reviews_box",
          "label": "Show Avatar Stats Box",
          "default": false
        }
      ]
    },
    {
      "type": "avatar",
      "name": "Avatar",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar Image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Kite Cards blocks",
      "category": "Custom",
      "blocks": [
        {
          "type": "kite_card"
        }
      ]
    }
  ]
}
{% endschema %}
