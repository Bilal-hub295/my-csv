      "blocks": {
        "text_TDteme": {
          "type": "text",
          "settings": {
            "title": "What is the Kitty Hawk Kites Return Policy?",
            "content": "<p>Please find our <a href=\"https://store.kittyhawk.com/pages/return-policy\" title=\"Return Policy\">full return policy here</a>.</p>"
          }
        },
        "text_UtXGng": {
          "type": "text",
          "settings": {
            "title": "What if My Product is Defective?",
            "content": "<p>We accept returns for any defective products. Please reach out to orders@kittyhawk.com with your order information and include a description and pictures of the defect. If there is a specific part that can be replaced we will do our best to get that part from the manufacturer if the customer would prefer.</p>"
          }
        }
