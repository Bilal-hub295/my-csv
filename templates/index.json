        "review_WLUCb8": {
          "type": "review",
          "settings": {
            "review_link": "#",
            "review_text": "\"I fly every weekend now.\"",
            "review_detail": "“After retiring, I wanted a hobby that got me outdoors. Kitty Hawk Kites helped me pick the right kite, and I’ve been flying ever since. Great quality and even better service.”",
            "author_image": "shopify://shop_images/Frame_1000003293.png",
            "author_name": "– Gary T., Oregon",
            "color_scheme-card": "scheme-3",
            "color_scheme-review": "scheme-5c8b66bf-7206-4f06-bc5e-1db9c6e84f2c"
          }
        },
        "review_tHBC9j": {
          "type": "review",
          "settings": {
            "review_link": "",
            "review_text": "\"The best part of our beach trip!\"",
            "review_detail": "“My husband and I bought a kite for our granddaughter — she couldn’t stop smiling! Easy to set up, and it flew perfectly even with low wind.”",
            "author_image": "shopify://shop_images/Frame_1000003293_1.png",
            "author_name": "– Linda M., Virginia",
            "color_scheme-card": "scheme-3",
            "color_scheme-review": "scheme-5c8b66bf-7206-4f06-bc5e-1db9c6e84f2c"
          }
        },
        "review_Rxc4cT": {
          "type": "review",
          "settings": {
            "review_link": "",
            "review_text": "\"Three generations flying together.\"",
            "review_detail": "“Bought a couple of kites for a family reunion. The kids loved it, the adults loved it — we’ll be talking about that day for years!”",
            "author_image": "shopify://shop_images/Frame_1000003293_2.png",
            "author_name": "– Susan R., South Carolina",
            "color_scheme-card": "scheme-3",
            "color_scheme-review": "scheme-5c8b66bf-7206-4f06-bc5e-1db9c6e84f2c"
